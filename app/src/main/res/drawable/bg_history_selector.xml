<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_card_pressed" />
            <stroke
                android:width="1dp"
                android:color="@color/accent_cyan" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/panel_bg_alt" />
            <stroke
                android:width="1dp"
                android:color="@color/line_subtle" />
        </shape>
    </item>
</selector>
